# 金价监控系统 - 生产环境配置
# 复制此文件为 .env 并填入实际值

# ============ 数据源配置 ============
# 数据源类型: sina(新浪财经), goldapi(GoldAPI.io), fallback(自动切换)
GOLD_DATA_SOURCE=fallback

# 数据采集间隔（秒）- 生产环境建议 60 秒以上
GOLD_FETCH_INTERVAL=60

# 数据库URL - 生产环境建议使用 PostgreSQL
# SQLite (开发/小规模)
GOLD_DATABASE_URL=sqlite:///data/gold_prices.db
# PostgreSQL (生产环境)
# GOLD_DATABASE_URL=postgresql://user:password@localhost:5432/gold_monitor

# GoldAPI.io API Key（推荐，数据准确）
GOLD_GOLDAPI_KEY=your-goldapi-key-here

# ============ 告警配置 ============
# 价格波动告警阈值（百分比）
GOLD_ALERT_THRESHOLD_PERCENT=1.0

# 价格上下限告警
GOLD_ALERT_PRICE_UPPER=2500.0
GOLD_ALERT_PRICE_LOWER=1800.0

# 波动检测时间窗口（分钟）
GOLD_ALERT_VOLATILITY_WINDOW=5

# ============ 邮件通知配置 ============
GOLD_SMTP_HOST=smtp.gmail.com
GOLD_SMTP_PORT=587
GOLD_SMTP_USERNAME=your-email@gmail.com
GOLD_SMTP_PASSWORD=your-app-password
GOLD_ALERT_EMAIL_TO=admin@example.com,alert@example.com

# ============ Webhook 通知配置 ============
# 支持: generic, dingtalk, wechat
GOLD_WEBHOOK_TYPE=dingtalk
GOLD_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# ============ Telegram 通知配置 ============
GOLD_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
GOLD_TELEGRAM_CHAT_ID=-1001234567890

# ============ 大模型配置 ============
# 提供商: anthropic, openai
GOLD_LLM_PROVIDER=anthropic

# Anthropic Claude API
GOLD_ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# OpenAI API（或兼容接口，如 DeepSeek、智谱等）
GOLD_OPENAI_API_KEY=sk-xxxxx
GOLD_OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 安全配置 ============
# 公网/生产环境必须开启管理接口鉴权，并使用高强度随机值。
GOLD_ENABLE_AUTH=true
GOLD_ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
GOLD_SECRET_KEY=replace-with-a-stable-long-random-secret-key
GOLD_RATE_LIMIT_PER_MINUTE=60
GOLD_CORS_ALLOW_ORIGINS=
GOLD_ENCRYPT_API_KEYS=true

# 还建议在 nginx 或云服务中配置：
# - HTTPS/SSL 证书
# - IP 白名单
