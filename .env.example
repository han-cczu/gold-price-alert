# 金价实时监控系统 - 环境配置

# ============ 基础配置 ============

# 数据源类型: mock(模拟), sina(新浪财经), goldapi(GoldAPI.io), fallback(多源降级)
GOLD_DATA_SOURCE=mock

# 数据采集间隔（秒）
GOLD_FETCH_INTERVAL=30

# 数据库URL
GOLD_DATABASE_URL=sqlite:///gold_prices.db

# GoldAPI.io API Key（使用goldapi数据源时需要）
GOLD_GOLDAPI_KEY=

# ============ 告警配置 ============

GOLD_ALERT_THRESHOLD_PERCENT=1.0
GOLD_ALERT_PRICE_UPPER=2500.0
GOLD_ALERT_PRICE_LOWER=1800.0
GOLD_ALERT_VOLATILITY_WINDOW=5

# ============ 通知渠道配置 ============

# 邮件通知（可选）
GOLD_SMTP_HOST=smtp.example.com
GOLD_SMTP_PORT=587
GOLD_SMTP_USERNAME=
GOLD_SMTP_PASSWORD=
GOLD_ALERT_EMAIL_TO=

# Webhook通知（可选，支持钉钉/企业微信）
GOLD_WEBHOOK_URL=
GOLD_WEBHOOK_TYPE=generic

# Telegram 通知（可选）
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_CHAT_ID=

# ============ AI 大模型配置 ============
# 注意：也可以通过 Web 界面设置（点击右上角"设置"按钮）

GOLD_LLM_PROVIDER=mock

# Anthropic Claude API
GOLD_ANTHROPIC_API_KEY=

# OpenAI API（或兼容接口，如 DeepSeek、通义千问等）
GOLD_OPENAI_API_KEY=
GOLD_OPENAI_BASE_URL=

# Tavily 搜索 API Key（可选）
# 配置后，使用 DeepSeek 等 OpenAI 兼容接口时可通过 function-calling 进行真实联网搜索。
# DeepSeek 官方 API 无原生联网工具，联网能力由我们自己执行 Tavily 搜索提供。
# 安全提示：请勿将此 Key 写入 llm_config.json（该文件被 git 跟踪）。
GOLD_TAVILY_API_KEY=

# ============ 安全配置 ============

# 主密钥（用于加密存储敏感信息，建议生产环境必须配置）
GOLD_SECRET_KEY=

# 管理接口 API Key（用于保护敏感接口，建议生产环境必须配置）
GOLD_ADMIN_API_KEY=

# 是否启用接口鉴权（生产环境建议设为 true）
# 注意：为 false 时所有管理接口不鉴权；公网部署务必设为 true 并配置 GOLD_ADMIN_API_KEY
GOLD_ENABLE_AUTH=false

# CORS 允许的来源（逗号分隔），为空表示仅同源（推荐）。
# 内置 Web UI 与 API 同源，通常无需配置；仅在需被其它域名的前端调用时填写。
# 例如：GOLD_CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
GOLD_CORS_ALLOW_ORIGINS=

# API 限流配置（每分钟请求数）
GOLD_RATE_LIMIT_PER_MINUTE=60

# 是否启用 API Key 加密存储（启用后用 Fernet 加密存储到 llm_config.json）
GOLD_ENCRYPT_API_KEYS=false

# ============ 数据生命周期配置 ============

# 分钟级数据保留天数
GOLD_DATA_RETENTION_DAYS=30

# 小时级数据聚合天数
GOLD_HOURLY_AGGREGATION_DAYS=90

# 日级数据聚合天数
GOLD_DAILY_AGGREGATION_DAYS=365

# 是否启用自动备份
GOLD_BACKUP_ENABLED=false

# 备份文件路径
GOLD_BACKUP_PATH=./backups
